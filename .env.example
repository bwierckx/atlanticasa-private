# ─────────────────────────────────────────────────────────────────────────────
#  Atlanticasa Private — environment variables
# ─────────────────────────────────────────────────────────────────────────────
#  Kopieer dit bestand naar `.env.local` en vul de gewenste waarden in.
#  Alleen ingevulde integraties worden geactiveerd. Zonder configuratie
#  blijft de site volledig werken; aanvragen worden dan server-side gelogd.

# Publieke basis-URL (voor metadata, sitemap en Open Graph)
NEXT_PUBLIC_SITE_URL=https://private.atlanticasa.com

# Publiek zichtbare contactgegevens (optioneel; overschrijven de defaults in site.ts)
NEXT_PUBLIC_CONTACT_EMAIL=private@atlanticasa.com

# ── E-mailnotificatie via Resend (optioneel) ────────────────────────────────
# Wanneer alle drie zijn ingevuld, wordt bij elke aanvraag een mail verstuurd.
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=aanvragen@atlanticasa.com
LEAD_FROM_EMAIL=website@atlanticasa.com

# ── CRM-webhook (optioneel) ─────────────────────────────────────────────────
# Generieke webhook voor HubSpot, Pipedrive, Brevo, Make, Zapier of eigen CRM.
CRM_WEBHOOK_URL=

# ── Privacyvriendelijke analytics (optioneel, bijv. Plausible) ──────────────
# Wordt pas geladen nadat de bezoeker toestemming heeft gegeven.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=
